<view wx:if="{{!hidden}}" class="tabbar-shell">
  <view class="tabbar">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tabbar__item {{selected === index ? 'tabbar__item--active' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <image class="tabbar__icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <text class="tabbar__text">{{item.text}}</text>
    </view>
  </view>
</view>
