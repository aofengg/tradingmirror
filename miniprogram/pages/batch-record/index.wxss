.batch-page { padding:12rpx 30rpx calc(env(safe-area-inset-bottom) + 34rpx); min-height:100vh; }
.batch-nav { display:flex; align-items:center; justify-content:space-between; min-height:68rpx; color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-back { display:flex; align-items:center; min-height:80rpx; padding-right:24rpx; }
.batch-title { display:block; margin:22rpx 0 8rpx; color:var(--color-ink); font-size:46rpx; font-weight:700; line-height:1.3; }
.batch-subtitle { display:block; color:var(--color-text-secondary); font-size:var(--font-size-sm); line-height:1.6; }
.batch-date-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:88rpx; margin:12rpx 0 8rpx; color:var(--color-text-primary); font-size:var(--font-size-sm); }
.batch-date-hint { margin-left:14rpx; color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-date-picker { min-width:180rpx; }
.batch-date-value { min-height:88rpx; display:flex; align-items:center; justify-content:flex-end; gap:12rpx; color:var(--color-primary); }
.batch-section-label { display:block; color:var(--color-ink-soft); font-size:var(--font-size-sm); font-weight:600; line-height:1.5; }
.batch-section-label > text { margin-left:10rpx; font-size:var(--font-size-xs); color:var(--color-text-secondary); font-weight:400; }
.batch-input-row { display:flex; align-items:center; gap:18rpx; margin:14rpx 0 16rpx; }
.batch-input { flex:1; min-width:0; height:94rpx; padding:0 20rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-paper); font-size:var(--font-size-md); color:var(--color-ink); }
.batch-placeholder { color:var(--color-text-placeholder); font-size:var(--font-size-sm); }
.batch-add { display:flex; align-items:center; min-height:88rpx; color:var(--color-primary); font-size:var(--font-size-sm); }
.batch-add--empty { color:var(--color-text-secondary); }
.batch-symbols { display:flex; flex-wrap:wrap; gap:14rpx; }
.batch-symbol { display:flex; align-items:center; gap:8rpx; min-height:82rpx; max-width:100%; padding:12rpx 24rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-round); background:var(--color-paper); color:var(--color-ink-soft); font-size:var(--font-size-sm); line-height:1.5; overflow-wrap:anywhere; word-break:break-all; }
.batch-symbol--selected { color:var(--color-paper); background:var(--color-primary); border-color:var(--color-primary); }
.batch-symbol-check { flex:none; }
.batch-section-label--action { margin-top:28rpx; }
.batch-actions { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx; margin-top:14rpx; }
.batch-action { min-height:88rpx; display:flex; align-items:center; justify-content:center; padding:10rpx 4rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-paper); color:var(--color-ink-soft); font-size:var(--font-size-sm); }
.batch-action--selected { color:var(--color-primary); border-color:var(--color-primary); background:var(--color-primary-soft); font-weight:600; }
.batch-reason-head { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; margin-top:14rpx; }
.batch-inline-link { min-height:80rpx; display:flex; align-items:center; color:var(--color-primary); font-size:var(--font-size-xs); }
.batch-context { display:block; min-height:44rpx; margin:0 0 14rpx; color:var(--color-primary); font-size:var(--font-size-xs); line-height:1.65; overflow-wrap:anywhere; }
.batch-reasons { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.batch-reason { min-height:96rpx; display:flex; align-items:center; justify-content:center; gap:8rpx; padding:18rpx 10rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); color:var(--color-ink-soft); background:var(--color-paper); font-size:var(--font-size-sm); text-align:center; line-height:1.55; }
.batch-reason--disabled { color:var(--color-text-secondary); opacity:.65; }
.batch-reason--selected { color:var(--color-primary); border-color:var(--color-primary); background:var(--color-primary-soft); font-weight:600; }
.batch-reason-check { flex:none; font-size:var(--font-size-xs); }
.batch-page .batch-save { display:flex; justify-content:center; align-items:center; width:100%; min-height:94rpx; margin:32rpx 0 0; padding:16rpx 20rpx; color:var(--color-paper); background:var(--color-primary); border-radius:var(--radius-md); font-size:var(--font-size-md); font-weight:650; line-height:1.5; }
.batch-page .batch-save[disabled] { color:var(--color-paper); background:var(--color-primary); opacity:.36; }
.batch-feedback { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0 20rpx; min-height:100rpx; margin-top:24rpx; padding-top:12rpx; border-top:1rpx solid var(--color-border); color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-feedback-actions { display:flex; align-items:center; gap:24rpx; flex-wrap:wrap; }
.batch-draft,.batch-message { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 0; color:var(--color-text-secondary); font-size:var(--font-size-xs); line-height:1.6; }
.batch-draft > view { color:var(--color-primary); min-height:70rpx; display:flex; align-items:center; }
.batch-message--error { color:var(--color-danger); }
.batch-supplement { margin-bottom:18rpx; }
.batch-note { box-sizing:border-box; width:100%; min-height:112rpx; padding:18rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-paper); font-size:var(--font-size-sm); line-height:1.65; color:var(--color-ink); }
.batch-time-row { display:flex; align-items:center; gap:20rpx; justify-content:space-between; min-height:84rpx; color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-time-clear { display:flex; align-items:center; min-height:80rpx; color:var(--color-text-secondary); }
.batch-reminder { display:flex; flex-direction:column; gap:8rpx; padding:16rpx 20rpx; margin-bottom:16rpx; border-radius:var(--radius-sm); background:var(--color-primary-mist); color:var(--color-primary-dark); font-size:var(--font-size-xs); line-height:1.6; }
.batch-reminder > text:first-child { color:var(--color-text-secondary); }
.batch-history { border-top:1rpx solid var(--color-border); }
.batch-receipt { padding:22rpx 0; border-bottom:1rpx solid var(--color-border); }
.batch-receipt-top { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; }
.batch-receipt-top > text:first-child { font-weight:650; overflow-wrap:anywhere; max-width:100%; }
.batch-receipt-status { color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-receipt-reason,.batch-receipt-time,.batch-receipt-note { display:block; margin-top:10rpx; font-size:var(--font-size-sm); line-height:1.65; overflow-wrap:anywhere; }
.batch-receipt-time { color:var(--color-text-secondary); font-size:var(--font-size-xs); }
.batch-receipt-open { justify-content:flex-end; }
.batch-more { min-height:88rpx; display:flex; align-items:center; justify-content:center; color:var(--color-primary); font-size:var(--font-size-sm); }
@media (max-width:340px) { .batch-page { padding-left:24rpx; padding-right:24rpx; } .batch-actions { gap:10rpx; } .batch-reasons { gap:12rpx; } .batch-reason { padding-left:8rpx; padding-right:8rpx; } }
