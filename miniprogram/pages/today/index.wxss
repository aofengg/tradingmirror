 .today-page { padding-top:28rpx; }
.hero .page-title { margin-top:10rpx;font-size:42rpx; }
.decision-actions { display:flex;gap:16rpx;margin-top:26rpx; }
.decision-card { flex:1;min-width:0;display:flex;align-items:center;gap:12rpx;min-height:126rpx;padding:20rpx 18rpx;border:1rpx solid var(--color-border);border-radius:24rpx;background:var(--color-paper); }
.decision-card--before { background:linear-gradient(135deg,#2b7963,#185442);color:#fff;border-color:transparent; }
.decision-card__icon { display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;flex:none;font-size:30rpx;color:var(--color-primary); }
.spark { width:15rpx;height:15rpx;border:4rpx solid rgba(255,255,255,.8);border-radius:50%; }
.decision-card__copy { min-width:0;flex:1; }.decision-card__title,.decision-card__sub { display:block; }
.decision-card__title { font-size:29rpx;font-weight:650;white-space:nowrap; }.decision-card__sub { margin-top:5rpx;font-size:20rpx;color:var(--color-text-secondary);line-height:1.5; }
.decision-card--before .decision-card__sub { color:rgba(255,255,255,.75); }.decision-card__arrow { font-size:35rpx;flex:none; }
.todo-section { margin-top:28rpx; }.todo-head { display:flex;align-items:center;justify-content:space-between;gap:16rpx; }
.todo-all { min-height:88rpx;display:flex;align-items:center;color:var(--color-primary);font-size:23rpx; }
.todo-tabs { display:flex;gap:6rpx;padding:6rpx;border-radius:20rpx;border:1rpx solid var(--color-border);background:rgba(230,235,228,.65); }
.todo-tab { flex:1;display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:82rpx;color:var(--color-text-secondary);font-size:25rpx;border-radius:15rpx; }
.todo-tab text { font-size:22rpx; }.todo-tab--active { background:var(--color-paper);color:var(--color-primary);font-weight:650;box-shadow:0 3rpx 10rpx rgba(31,49,42,.06); }
.intent-stack { position:relative;margin-top:18rpx;overflow:hidden;border-radius:var(--radius-lg); }.intent-stack--multiple { padding-bottom:10rpx; }
.intent-stack__layer { position:absolute;right:14rpx;left:14rpx;bottom:0;height:80rpx;border:1rpx solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-paper); }
.task-card { position:relative;padding:22rpx 26rpx; }.task-card__head { display:flex;align-items:center;justify-content:space-between;gap:12rpx; }
.task-card__time { color:var(--color-text-secondary);font-size:22rpx; }.task-card__count { min-height:88rpx;display:flex;align-items:center;color:var(--color-primary);font-size:22rpx;margin:-20rpx 0;flex:none; }
.task-card__title-row { display:flex;align-items:center;gap:12rpx;margin-top:8rpx; }.task-card__title { flex:1;min-width:0;font-size:35rpx;line-height:1.4;font-weight:700;overflow-wrap:anywhere;word-break:break-all; }
.task-card__asset-link { flex:none;display:flex;align-items:center;min-height:88rpx;color:var(--color-primary);font-size:23rpx; }
.task-card__reason { display:block;margin-top:4rpx;color:var(--color-ink-soft);font-size:29rpx;line-height:1.6; }
.task-card__question-row { display:flex;align-items:center;justify-content:space-between;margin-top:14rpx;gap:16rpx;min-height:66rpx; }.task-card__question { color:var(--color-text-secondary);font-size:24rpx; }
.task-card__next { display:flex;align-items:center;justify-content:flex-end;min-height:88rpx;color:var(--color-primary);font-size:23rpx;flex:none; }.task-card__next--review { margin-bottom:-16rpx; }
.task-card__actions { display:flex;gap:16rpx;margin-top:6rpx; }.task-card__button { flex:1;min-height:88rpx; }.task-card__actions--disabled { opacity:.5;pointer-events:none; }
.task-card__context { min-height:88rpx;display:flex;align-items:center;justify-content:center;color:var(--color-text-secondary);font-size:23rpx;margin:6rpx 0 -16rpx; }
.task-card__review { margin-top:24rpx;min-height:88rpx; }
.task-card--leaving { animation:intentLeave .18s ease-in forwards; }.task-card--page-out { animation:intentPageOut .16s ease-in both; }.task-card--page-in { animation:intentPageIn .22s ease-out both; }
@keyframes intentLeave { to { opacity:0;transform:translateX(-24rpx); } } @keyframes intentPageOut { to { transform:translateX(-106%); } } @keyframes intentPageIn { from { transform:translateX(106%); } to { transform:translateX(0); } }
.focus-card { display:flex;align-items:center;gap:18rpx;margin-top:24rpx;padding:22rpx 26rpx;border:1rpx solid rgba(190,172,140,.3);border-radius:24rpx;background:#f6f1e7; }
.focus-card > view { flex:1;min-width:0; }.focus-card__content { display:block;margin-top:8rpx;font-size:26rpx;color:#66563d;line-height:1.6; }.focus-card__link { flex:none;display:flex;align-items:center;min-height:88rpx;font-size:23rpx;color:var(--color-primary); }
.calm-card,.status-shell { margin-top:24rpx;padding:26rpx; }.calm-card__title,.calm-card__sub { display:block; }.calm-card__title { font-size:30rpx;font-weight:650; }.calm-card__sub { margin-top:8rpx;font-size:25rpx;color:var(--color-text-secondary); }
.welcome-overlay { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; padding: 36rpx 24rpx calc(env(safe-area-inset-bottom) + 30rpx); background: rgba(18,32,27,.52); backdrop-filter: blur(8rpx); }
.welcome-card { width: 100%; padding: 42rpx 36rpx 24rpx; border: 1rpx solid rgba(255,255,255,.68); border-radius: 42rpx; background: var(--color-paper); box-shadow: 0 30rpx 80rpx rgba(14,33,26,.25); text-align: center; }
.welcome-card__mark { height: 68rpx; display: flex; align-items: flex-end; justify-content: center; gap: 8rpx; margin-bottom: 24rpx; }
.welcome-card__mark view { width: 10rpx; border-radius: 6rpx; background: var(--color-primary-light); }.welcome-card__mark view:nth-child(1) { height: 25rpx; }.welcome-card__mark view:nth-child(2) { height: 47rpx; }.welcome-card__mark view:nth-child(3) { height: 66rpx; }
.welcome-card__eyebrow { display: block; color: var(--color-primary); font-size: var(--font-size-xs); font-weight: 650; letter-spacing: 2rpx; }
.welcome-card__title { display: block; margin-top: 13rpx; color: var(--color-ink); font-size: 45rpx; font-weight: 720; letter-spacing: -1rpx; }
.welcome-card__copy { display: block; margin: 17rpx auto 0; color: var(--color-text-secondary); font-size: var(--font-size-sm); line-height: 1.65; }
.welcome-flow { display: flex; align-items: center; margin: 34rpx 8rpx 0; padding: 24rpx 20rpx; border-radius: var(--radius-md); background: var(--color-primary-mist); }
.welcome-flow > view:not(.welcome-flow__line) { width: 180rpx; display: flex; flex-direction: column; align-items: center; flex: none; }
.welcome-flow > view > text:first-child { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: var(--color-primary); font-size: 20rpx; font-weight: 700; }
.welcome-flow > view > text:last-child { margin-top: 10rpx; color: var(--color-ink-soft); font-size: var(--font-size-2xs); font-weight: 600; }
.welcome-flow__line { height: 2rpx; flex: 1; margin: 0 8rpx 27rpx; background: var(--color-primary-light); opacity: .55; }
.welcome-card__promise { display: block; margin-top: 20rpx; color: var(--color-text-placeholder); font-size: var(--font-size-2xs); }
.welcome-card__primary { margin-top: 31rpx; }
.welcome-card__skip { min-height: 70rpx; display: flex; align-items: center; justify-content: center; margin-top: 5rpx; color: var(--color-text-secondary); font-size: var(--font-size-xs); }

.todo-tab,.welcome-card__skip { min-height:88rpx; }
