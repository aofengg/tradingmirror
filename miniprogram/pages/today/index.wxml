<view class="page today-page">
  <view class="page-content">
    <view class="hero"><text class="eyebrow">{{dateLabel}}</text><text class="page-title">留住这次决定</text></view>
    <view class="decision-actions">
      <view class="decision-card decision-card--before" bindtap="startBefore" hover-class="button-pressed" role="button"><view class="decision-card__icon"><view class="spark"></view></view><view class="decision-card__copy"><text class="decision-card__title">准备操作</text><text class="decision-card__sub">先记下动机</text></view><text class="decision-card__arrow">›</text></view>
      <view class="decision-card decision-card--after" bindtap="startAfter" hover-class="button-pressed" role="button"><view class="decision-card__icon"><text>✓</text></view><view class="decision-card__copy"><text class="decision-card__title">刚刚操作</text><text class="decision-card__sub">留下当时的理由</text></view><text class="decision-card__arrow">›</text></view>
    </view>
    <view wx:if="{{loading}}" class="card status-shell"><state-view type="loading" title="正在整理待办" compact /></view>
    <block wx:elif="{{!loadError}}">
      <view wx:if="{{pendingIntent || pending}}" class="todo-section">
        <view class="todo-head"><text class="section-kicker">今日待办</text><view class="todo-all" bindtap="openAllTodos" hover-class="control-pressed" hover-stay-time="80">全部待办 ›</view></view>
        <view class="todo-tabs"><view class="todo-tab {{todoTab === 'confirm' ? 'todo-tab--active' : ''}}" data-tab="confirm" bindtap="chooseTodoTab" hover-class="control-pressed" hover-stay-time="80">待确认 <text>{{pendingIntentCount}}</text></view><view class="todo-tab {{todoTab === 'review' ? 'todo-tab--active' : ''}}" data-tab="review" bindtap="chooseTodoTab" hover-class="control-pressed" hover-stay-time="80">待回看 <text>{{pendingReflectionCount}}</text></view></view>
        <view wx:if="{{todoTab === 'confirm' && pendingIntent}}" class="intent-stack {{pendingIntentCount > 1 ? 'intent-stack--multiple' : ''}}">
          <view wx:if="{{pendingIntentCount > 1}}" class="intent-stack__layer"></view>
          <view class="card task-card task-card--intent {{intentLeaving ? 'task-card--leaving' : ''}} {{intentAnimation === 'page-out' ? 'task-card--page-out' : ''}} {{intentAnimation === 'page-in' ? 'task-card--page-in' : ''}}">
            <view class="task-card__head"><text class="task-card__time">{{pendingIntent.relative_label}} · 操作前的想法</text><view wx:if="{{pendingIntentCount > 1}}" class="task-card__count" catchtap="openPendingRecords">共 {{pendingIntentCount}} 条 ›</view></view>
            <view class="task-card__title-row"><text class="task-card__title">{{pendingIntent.symbol}} · {{pendingIntent.action_label}}</text><view class="task-card__asset-link" data-source="intent" catchtap="openAssetHistory" role="button" hover-class="control-pressed" hover-stay-time="80">个股历史 ›</view></view>
            <text class="task-card__reason">“{{pendingIntent.reason_label}}”</text>
            <view class="task-card__question-row"><text class="task-card__question">后来真的执行了吗？</text><view wx:if="{{pendingIntentCount > 1}}" class="task-card__next" catchtap="showNextIntent">换一条 ›</view></view>
            <view class="task-card__actions {{intentSaving || intentSwitching ? 'task-card__actions--disabled' : ''}}"><view class="secondary-button task-card__button" data-status="cancelled" bindtap="confirmIntent" hover-class="control-pressed" hover-stay-time="80">未执行</view><view class="primary-button task-card__button" data-status="executed" bindtap="confirmIntent" hover-class="control-pressed" hover-stay-time="80">已执行</view></view>
            <view class="task-card__context" bindtap="toggleIntentContext" hover-class="control-pressed" hover-stay-time="80">相似决定 ›</view>
            <related-history id="relatedHistory" source="{{pendingIntent}}" sheet-only />
          </view>
        </view>
        <view wx:elif="{{todoTab === 'review' && pending}}" class="intent-stack {{pendingReflectionCount > 1 ? 'intent-stack--multiple' : ''}}">
          <view wx:if="{{pendingReflectionCount > 1}}" class="intent-stack__layer"></view>
          <view class="card task-card task-card--reflection">
            <view class="task-card__head"><text class="task-card__time">{{pending.relative_label}} · 已执行</text><view wx:if="{{pendingReflectionCount > 1}}" class="task-card__count" catchtap="openReflectionRecords">共 {{pendingReflectionCount}} 条 ›</view></view>
            <view class="task-card__title-row"><text class="task-card__title">{{pending.symbol}} · {{pending.action_label}}</text><view class="task-card__asset-link" data-source="reflection" catchtap="openAssetHistory" role="button" hover-class="control-pressed" hover-stay-time="80">个股历史 ›</view></view>
            <text class="task-card__reason">“{{pending.reason_label}}”</text>
            <view class="primary-button task-card__review" bindtap="openReflection" hover-class="button-pressed">记录现在的感受</view>
            <view wx:if="{{pendingReflectionCount > 1}}" class="task-card__next task-card__next--review" catchtap="showNextReflection">{{reflectionSwitching ? '加载中…' : '换一条 ›'}}</view>
          </view>
        </view>
        <view wx:else class="card calm-card"><state-view type="empty" title="{{todoTab === 'confirm' ? '没有待确认的想法' : '没有待回看的操作'}}" compact /></view>
      </view>
      <view wx:else class="card calm-card"><text class="calm-card__title">今天没有待办</text><text class="calm-card__sub">没有交易，也是一种纪律。</text><view wx:if="{{recentCount}}" class="todo-all" bindtap="openRecords" hover-class="control-pressed" hover-stay-time="80">查看最近记录 ›</view></view>
      <view class="focus-card" bindtap="openFocus" role="button" hover-class="control-pressed" hover-stay-time="80"><view><text class="section-kicker">本周提醒</text><text class="focus-card__content">{{currentFocus && currentFocus.label ? '少一次“' + currentFocus.label + '”。' : '去复盘，留下一条行为提醒'}}</text></view><text class="focus-card__link">调整 ›</text></view>
    </block>
    <view wx:else class="card status-shell"><state-view type="error" title="待办暂时没打开" action-text="重新加载" bind:action="retry" compact /></view>
  </view>
  <view wx:if="{{showWelcome}}" class="welcome-overlay" catchtouchmove="preventTouchMove">
    <view class="welcome-card">
      <view class="welcome-card__mark"><view></view><view></view><view></view></view>
      <text class="welcome-card__eyebrow">欢迎来到交易留痕</text>
      <text class="welcome-card__title">少看结果，多看行为</text>
      <text class="welcome-card__copy">用不到 1 分钟，记下操作前后的真实想法。</text>
      <view class="welcome-flow"><view><text>1</text><text>留下当时决定</text></view><view class="welcome-flow__line"></view><view><text>2</text><text>过后回看感受</text></view></view>
      <text class="welcome-card__promise">不评价股票涨跌，只帮助你看清自己。</text>
      <view class="primary-button welcome-card__primary" hover-class="button-pressed" bindtap="startFirstRecord">记下第一笔</view>
      <view class="welcome-card__skip" bindtap="dismissWelcome" hover-class="control-pressed" hover-stay-time="80">先随便看看</view>
    </view>
  </view>
</view>
