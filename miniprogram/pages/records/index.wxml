<view class="page records-page">
  <view class="page-content">
    <view class="records-head">
      <view>

        <text class="page-title">记录</text>
        <text class="page-subtitle">找到当时的决定与后来的感受。</text>
      </view>
      <view class="add-button" role="button" aria-label="记录刚刚的操作" hover-class="button-pressed" bindtap="createRecord">
        <view class="add-button__line"></view><view class="add-button__line add-button__line--vertical"></view>
      </view>
    </view>

    <view class="records-view-switch">
      <view class="records-view-switch__item {{viewMode === 'time' ? 'records-view-switch__item--active' : ''}}" data-mode="time" bindtap="chooseView" hover-class="control-pressed" hover-stay-time="80">按时间看</view>
      <view class="records-view-switch__item {{viewMode === 'asset' ? 'records-view-switch__item--active' : ''}}" data-mode="asset" bindtap="chooseView" hover-class="control-pressed" hover-stay-time="80">按个股看</view>
    </view>
    <block wx:if="{{viewMode === 'time'}}">
    <scroll-view wx:if="{{events.length}}" class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view wx:for="{{filters}}" wx:key="key" class="filter-chip {{filter === item.key ? 'filter-chip--active' : ''}}" data-filter="{{item.key}}" bindtap="chooseFilter" hover-class="control-pressed" hover-stay-time="80">
          <text>{{item.label}}</text>
          <text wx:if="{{item.key === 'pending' && todoCounts.all}}" class="filter-chip__count">{{todoCounts.all}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{events.length && filter === 'pending' && !todoUnavailable}}" class="todo-filter" aria-label="待办类型">
      <view wx:for="{{todoFilters}}" wx:key="key" class="todo-filter__item {{todoFilter === item.key ? 'todo-filter__item--active' : ''}}" data-filter="{{item.key}}" bindtap="chooseTodoFilter" hover-class="control-pressed" hover-stay-time="80">
        <text>{{item.label}}</text><text class="todo-filter__count">{{item.count}}</text>
      </view>
    </view>

    <view wx:if="{{loadError && events.length}}" class="inline-retry" bindtap="retry" hover-class="control-pressed" hover-stay-time="80">更新暂时失败，点此重试</view>
    <view wx:if="{{loading}}" class="card state-card">
      <state-view type="loading" title="正在翻开记录" description="稍等一下" />
    </view>

    <view wx:elif="{{filter === 'pending' && todoUnavailable}}" class="card state-card"><state-view type="error" title="待办暂时没打开" action-text="重新加载" bind:action="retry" compact /></view>
    <view wx:elif="{{filteredEvents.length}}" class="record-list {{filter === 'pending' ? 'record-list--todo' : ''}}">
      <block wx:for="{{filteredEvents}}" wx:key="_id">
        <view wx:if="{{item.todo_group_label}}" class="todo-group-head">
          <text>{{item.todo_group_label}}</text><text>{{item.todo_group_count}} 条</text>
        </view>
        <view class="record-swipe {{draggingSwipeId === item._id ? 'record-swipe--dragging' : ''}}" data-index="{{index}}" bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd" bindtouchcancel="onCardTouchCancel">
        <view wx:if="{{item.swipe_offset < 0}}" class="record-swipe__delete" data-id="{{item._id}}" data-symbol="{{item.symbol}}" catchtap="deleteRecord" hover-class="control-pressed" hover-stay-time="80"><text>删除</text></view>
        <view class="record-swipe__content" style="transform: translateX({{item.swipe_offset || 0}}px);">
          <view class="card record-card record-card--{{item.plan_status}}" data-id="{{item._id}}" data-status="{{item.execution_status}}" bindtap="openReflection" hover-class="control-pressed" hover-stay-time="80">
            <view class="record-card__rail"></view>
            <view class="record-card__head record-card__head--{{item.symbol_layout}}">
              <view class="record-card__identity record-card__identity--{{item.symbol_layout}}">
                <text class="record-card__symbol">{{item.symbol}}</text>
                <view class="record-card__badges">
                  <text class="action-tag action-tag--{{item.action}}">{{item.action_label}}</text>

                </view>
              </view>
              <view class="record-card__tools">
                <text class="record-card__time">{{item.created_label}}</text>
                <view class="record-card__menu" data-id="{{item._id}}" data-symbol="{{item.symbol}}" data-status="{{item.execution_status}}" data-reflection-count="{{item.reflection_count}}" catchtap="openRecordMenu" hover-class="control-pressed" hover-stay-time="80"><image src="/assets/icons/more.svg" mode="aspectFit" /></view>
              </view>
            </view>

            <text class="record-card__reason">“{{item.reason_label}}”</text>
            <view class="record-card__footer">
              <text class="pill {{item.plan_status === 'impulsive' ? 'pill--warm' : ''}}">{{item.plan_label}}</text>
              <view wx:if="{{item.execution_status === 'pending'}}" class="record-task" data-id="{{item._id}}" catchtap="openConfirmation" hover-class="control-pressed" hover-stay-time="80">确认是否执行 ›</view>
              <view wx:elif="{{item.review_status === 'due'}}" class="record-task" data-id="{{item._id}}" catchtap="startReview" hover-class="control-pressed" hover-stay-time="80">去回看 ›</view>
              <text wx:elif="{{item.execution_status === 'cancelled'}}" class="record-card__status">未执行</text>
              <text wx:else class="record-card__status">{{item.latest_feeling_label ? '最近感受：' + item.latest_feeling_label : item.review_label}}</text>
            </view>
          </view>
        </view>
        </view>
      </block>
      <block wx:if="{{filter !== 'pending'}}">
        <view wx:if="{{moreError}}" class="records-more records-more--retry" bindtap="onReachBottom" hover-class="control-pressed" hover-stay-time="80">更早记录暂时没打开，点此重试</view><view wx:elif="{{loadingMore}}" class="records-more">正在翻开更早的记录…</view>
        <view wx:elif="{{!hasMore && events.length > 10}}" class="records-more">已经看到最早一条</view>
      </block>
    </view>

    <view wx:elif="{{events.length && !filteredEvents.length}}" class="card state-card">
      <state-view type="empty" title="{{filter === 'pending' ? '这里暂时没有待办' : '这一类还没有记录'}}" description="{{filter === 'pending' ? '新的待确认或待回看会出现在这里' : '换个筛选，或者记下下一次真实操作'}}" compact />
    </view>

    <view wx:elif="{{!loadError}}" class="card state-card state-card--empty">
      <state-view type="empty" title="第一条痕迹，从下一次操作开始" description="不用补写过去，也不用写长日记。十几秒，留下当时最主要的原因。" action-text="记下第一次" bind:action="createRecord" />
    </view>

    <view wx:else class="card state-card">
      <state-view type="error" title="记录暂时没打开" description="稍后重试，不会影响已经保存的内容" action-text="重新加载" bind:action="retry" />
    </view>
    </block>
    <block wx:else>
      <view class="asset-search-shell"><input class="asset-search" placeholder="搜索代码或名称" placeholder-class="asset-search__placeholder" value="{{assetQuery}}" bindinput="searchAssets" maxlength="30" /><view wx:if="{{assetQuery}}" class="asset-search-clear" bindtap="clearAssetSearch" role="button" aria-label="清空搜索" hover-class="control-pressed">×</view></view>
      <view class="asset-filter-list">
        <view class="filter-chip {{!assetTodoOnly ? 'filter-chip--active' : ''}}" data-filter="all" bindtap="chooseAssetFilter" hover-class="control-pressed" hover-stay-time="80">全部个股</view>
        <view class="filter-chip {{assetTodoOnly ? 'filter-chip--active' : ''}}" data-filter="todo" bindtap="chooseAssetFilter" hover-class="control-pressed" hover-stay-time="80">有待办</view>
      </view>
      <view wx:for="{{assetItems}}" wx:key="key" class="card asset-card" data-key="{{item.key}}" bindtap="openAsset" hover-class="button-pressed">
        <view class="asset-card__head"><text class="record-card__symbol">{{item.symbol}}</text><text class="pill">{{item.market_label}}</text></view>
        <text class="asset-card__last">{{item.latest.action_label}} · {{item.latest.execution_label}} · {{item.latest.history_date}}</text>
        <text class="asset-card__reason">“{{item.latest.reason_label}}”</text>
        <view class="asset-card__footer"><text>{{item.count}} 条记录{{item.pending_count ? ' · 待确认 ' + item.pending_count : ''}}{{item.review_count ? ' · 待回看 ' + item.review_count : ''}}</text><text>查看历史 ›</text></view>
      </view>
      <view wx:if="{{assetFailed}}" class="records-more" bindtap="loadAssets" hover-class="control-pressed" hover-stay-time="80">暂时没能打开，点此重试</view>
      <view wx:elif="{{assetLoading}}" class="records-more">正在找回个股足迹…</view>
      <view wx:elif="{{!assetItems.length}}" class="card state-card"><state-view type="empty" title="{{assetQuery ? '没有找到这个标的' : assetTodoOnly ? '暂时没有个股待办' : '第一条个股足迹，从下一次记录开始'}}" description="{{assetQuery ? '试试代码或曾用名称' : '每次决定，都会接在这只股票的足迹里'}}" /></view>
      <view wx:elif="{{!assetMore}}" class="records-more">以上为全部个股</view>
    </block>
  </view>
</view>
