<view class="page mine-page"><view class="page-content">
  <view class="brand-card"><image class="brand-avatar" src="/assets/images/app-avatar.png" mode="aspectFill" /><view class="brand-card__copy"><text class="brand-card__name">交易留痕</text><text class="brand-card__sub">记下决定，过后回看。</text></view></view>
  <text class="settings-heading">使用与说明</text>
  <view class="card settings-card">
    <view class="settings-row" bindtap="showUsage" role="button" hover-class="control-pressed" hover-stay-time="80"><image class="settings-row__icon" src="/assets/icons/tab-records.svg" mode="aspectFit" /><view class="settings-row__copy"><text>怎么使用</text><text>记录、确认与回看</text></view><image class="row-arrow" src="/assets/icons/arrow-right.svg" /></view>
    <view class="settings-row" bindtap="showDataNotice" role="button" hover-class="control-pressed" hover-stay-time="80"><image class="settings-row__icon" src="/assets/icons/shield.svg" /><view class="settings-row__copy"><text>数据与隐私</text><text>记录与当前微信账号绑定</text></view><image class="row-arrow" src="/assets/icons/arrow-right.svg" /></view>
    <view class="settings-row" bindtap="showAbout" role="button" hover-class="control-pressed" hover-stay-time="80"><image class="settings-row__icon" src="/assets/icons/info.svg" /><view class="settings-row__copy"><text>关于交易留痕</text><text>产品理念与使用边界</text></view><image class="row-arrow" src="/assets/icons/arrow-right.svg" /></view>
  </view>
  <text class="disclaimer">不替你预测市场，只帮你记住当时的自己。</text>
</view></view>
