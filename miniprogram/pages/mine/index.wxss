.mine-page { padding-top: 34rpx; }
.brand-card { position: relative; display: flex; align-items: center; min-height: 146rpx; padding: 24rpx 24rpx 24rpx 22rpx; overflow: hidden; border-radius: var(--radius-xl); color: #fff; background: linear-gradient(145deg, #164b42 0%, #0d3333 100%); box-shadow: 0 18rpx 42rpx rgba(18,57,49,.2); }
.brand-card__halo { position: absolute; top: -100rpx; right: -40rpx; width: 240rpx; height: 240rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 50%; }
.brand-avatar { width: 92rpx; height: 92rpx; flex: none; border: 1rpx solid rgba(255,255,255,.38); border-radius: 28rpx; box-shadow: 0 9rpx 24rpx rgba(0,0,0,.16); }
.brand-card__copy { position: relative; z-index: 1; flex: 1; min-width: 0; margin-left: 22rpx; }
.brand-card__name, .brand-card__sub { display: block; }
.brand-card__name { font-size: 35rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-card__sub { margin-top: 7rpx; color: rgba(255,255,255,.65); font-size: var(--font-size-xs); }
.brand-card__version { position: relative; z-index: 1; align-self: flex-start; color: rgba(255,255,255,.32); font-family: Georgia, serif; font-size: 24rpx; }
.principle-card { position: relative; margin-top: 20rpx; padding: 29rpx 31rpx; overflow: hidden; border: 1rpx solid rgba(190,172,140,.44); border-radius: var(--radius-lg); background: linear-gradient(145deg, #fffdf7, #f3ecdf); }
.principle-card::after { content: '“'; position: absolute; top: -12rpx; right: 25rpx; color: rgba(153,103,44,.11); font-family: Georgia, serif; font-size: 132rpx; line-height: 1; }
.principle-card__label { color: var(--color-warm-dark); font-size: var(--font-size-2xs); font-weight: 650; letter-spacing: 2rpx; }
.principle-card__quote { display: block; margin-top: 16rpx; color: #4b3826; font-size: 31rpx; font-weight: 620; line-height: 1.6; }
.principle-card__rule { width: 52rpx; height: 3rpx; margin-top: 19rpx; background: rgba(135,82,31,.36); }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 4rpx 16rpx; }
.section-head--symbols { margin-top: 30rpx; }
.section-head__action { min-height: 60rpx; display: flex; align-items: center; color: var(--color-primary); font-size: var(--font-size-2xs); font-weight: 650; }
.focus-card { min-height: 122rpx; display: flex; align-items: center; padding: 24rpx; }
.focus-card__icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 22rpx; background: var(--color-primary-soft); }
.focus-card__icon view { width: 24rpx; height: 24rpx; border: 4rpx solid var(--color-primary); border-radius: 50%; box-shadow: 0 0 0 7rpx rgba(31,104,85,.1); }
.focus-card__copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.focus-card__title, .focus-card__content { display: block; }
.focus-card__title { color: var(--color-text-secondary); font-size: var(--font-size-2xs); }
.focus-card__content { margin-top: 7rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 650; }
.focus-card__content--muted { color: var(--color-text-secondary); font-size: var(--font-size-xs); font-weight: 500; line-height: 1.5; }
.row-arrow { width: 30rpx; height: 30rpx; flex: none; margin-left: 14rpx; opacity: .65; }
.symbol-card { min-height: 106rpx; padding: 22rpx 24rpx; }
.symbol-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.symbol-pill { min-height: 58rpx; display: flex; align-items: center; padding: 0 21rpx; border: 1rpx solid rgba(31,104,85,.16); border-radius: var(--radius-round); color: var(--color-primary-dark); background: var(--color-primary-mist); font-size: var(--font-size-xs); font-weight: 650; letter-spacing: .5rpx; }
.symbol-empty { min-height: 62rpx; display: flex; align-items: center; color: var(--color-text-placeholder); font-size: var(--font-size-xs); }
.symbol-empty__dot { width: 11rpx; height: 11rpx; margin-right: 13rpx; border: 3rpx solid var(--color-border-strong); border-radius: 50%; }
.settings-card { margin-top: 22rpx; padding: 0 24rpx; }
.settings-row { min-height: 116rpx; display: flex; align-items: center; border-bottom: 1rpx solid var(--color-border); }
.settings-row:last-child { border-bottom: 0; }
.settings-row__icon { width: 52rpx; height: 52rpx; flex: none; }
.settings-row__copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.settings-row__copy text { display: block; }
.settings-row__copy text:first-child { font-weight: 620; }
.settings-row__copy text:last-child { margin-top: 5rpx; color: var(--color-text-placeholder); font-size: var(--font-size-2xs); }
.disclaimer { display: block; padding: 29rpx 12rpx 0; color: var(--color-text-placeholder); font-size: var(--font-size-2xs); line-height: 1.6; text-align: center; }
