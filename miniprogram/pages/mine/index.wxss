.mine-page { padding-top:30rpx; }.brand-card { display:flex;align-items:center;gap:22rpx;padding:24rpx 26rpx;border:1rpx solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-paper); }.brand-avatar { width:84rpx;height:84rpx;border-radius:24rpx;flex:none; }.brand-card__copy { min-width:0;flex:1; }.brand-card__name,.brand-card__sub { display:block; }.brand-card__name { font-size:34rpx;font-weight:700; }.brand-card__sub { margin-top:8rpx;font-size:25rpx;color:var(--color-text-secondary); }.settings-heading { display:block;margin:34rpx 4rpx 16rpx;color:var(--color-text-secondary);font-size:24rpx; }.settings-card { padding:0 24rpx; }.settings-row { display:flex;align-items:center;gap:18rpx;min-height:128rpx;border-bottom:1rpx solid var(--color-border); }.settings-row:last-child { border:0; }.settings-row__icon { width:44rpx;height:44rpx;flex:none; }.settings-row__copy { flex:1;min-width:0; }.settings-row__copy text { display:block; }.settings-row__copy text:first-child { font-size:28rpx;font-weight:600; }.settings-row__copy text:last-child { margin-top:6rpx;font-size:23rpx;color:var(--color-text-secondary); }.row-arrow { width:30rpx;height:30rpx;flex:none; }.disclaimer { display:block;margin-top:28rpx;color:var(--color-text-secondary);font-size:23rpx;line-height:1.7;text-align:center; }
