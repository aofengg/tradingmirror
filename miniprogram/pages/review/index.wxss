.review-page { padding-top: 34rpx; }
.period-switch { width: 300rpx; height: 64rpx; display: flex; align-items: center; margin-bottom: 30rpx; padding: 5rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-round); background: rgba(255,254,250,.72); }
.period-switch__item { height: 52rpx; display: flex; align-items: center; justify-content: center; flex: 1; border-radius: var(--radius-round); color: var(--color-text-secondary); font-size: var(--font-size-xs); font-weight: 580; transition: color .16s ease, background .16s ease; }
.period-switch__item--active { color: #fff; background: var(--color-ink-soft); box-shadow: 0 6rpx 14rpx rgba(31,49,42,.13); }
.state-card { margin-top: 38rpx; overflow: hidden; }
.trend-card { margin-top: 18rpx; padding: 25rpx 27rpx; overflow: hidden; }
.trend-card__head { display: flex; align-items: center; justify-content: space-between; }
.trend-card--expanded .trend-card__head { align-items: flex-start; margin-bottom: 19rpx; }
.trend-card__title { display: block; margin-top: 7rpx; color: var(--color-ink); font-size: 31rpx; font-weight: 680; }
.trend-card__action { min-height: 52rpx; display: flex; align-items: center; padding-left: 22rpx; color: var(--color-primary); font-size: var(--font-size-2xs); font-weight: 600; }
.trend-card__chevron { width: 13rpx; height: 13rpx; margin: -6rpx 3rpx 0 11rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); transition: transform .2s ease, margin .2s ease; }
.trend-card__chevron--up { margin-top: 6rpx; transform: rotate(225deg); }
.trend-card__pending { color: var(--color-text-placeholder); font-size: var(--font-size-2xs); }
.trend-guide { display: flex; align-items: center; margin-top: 18rpx; padding: 15rpx 16rpx; border-radius: var(--radius-sm); color: var(--color-text-secondary); background: var(--color-primary-mist); }
.trend-guide__mark { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; flex: none; margin-right: 12rpx; border-radius: 50%; color: #fff; background: var(--color-primary); font-size: 19rpx; font-weight: 700; }
.trend-guide > view:nth-child(2) { min-width: 0; flex: 1; }.trend-guide > view:nth-child(2) text { display: block; }.trend-guide > view:nth-child(2) text:first-child { color: var(--color-ink-soft); font-size: 22rpx; font-weight: 650; }.trend-guide > view:nth-child(2) text:last-child { margin-top: 3rpx; font-size: 19rpx; }
.trend-guide > text:last-child { margin-left: 12rpx; color: var(--color-primary); font-size: 20rpx; font-weight: 650; }
.trend-progress { margin-top: 22rpx; }
.trend-progress__track { height: 8rpx; overflow: hidden; border-radius: var(--radius-round); background: var(--color-bg-soft); }
.trend-progress__track view { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary)); }
.trend-progress > text { display: block; margin-top: 13rpx; color: var(--color-text-placeholder); font-size: 21rpx; line-height: 1.45; }
.trend-preview { min-height: 92rpx; display: flex; align-items: center; margin-top: 10rpx; }
.trend-preview__value { width: 132rpx; flex: none; }
.trend-preview__value > view { display: flex; align-items: baseline; color: var(--color-ink); }
.trend-preview__value > view text:first-child { font-size: 44rpx; font-weight: 720; letter-spacing: -1rpx; line-height: 1; }
.trend-preview__value > view text:last-child { margin-left: 3rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.trend-preview__value > text { display: block; margin-top: 8rpx; color: var(--color-text-placeholder); font-size: 20rpx; }
.trend-preview__chart { min-width: 0; flex: 1; }
.trend-preview__component, .trend-full__component { display: block; width: 100%; }
.trend-preview__insight { display: block; overflow: hidden; margin-top: 5rpx; padding-top: 15rpx; border-top: 1rpx solid var(--color-border); color: var(--color-text-placeholder); font-size: 21rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.trend-card__legend { display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; margin: -52rpx 0 18rpx; color: var(--color-text-placeholder); font-size: 20rpx; }.trend-card__legend view { width: 20rpx; height: 5rpx; border-radius: 4rpx; background: var(--color-primary-light); }
.trend-card__insight { min-height: 62rpx; display: flex; align-items: center; margin-top: 18rpx; padding: 12rpx 15rpx; border-radius: var(--radius-sm); color: var(--color-text-secondary); background: var(--color-primary-mist); font-size: var(--font-size-2xs); line-height: 1.5; }
.trend-card__spark { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; flex: none; margin-right: 11rpx; border-radius: 50%; color: var(--color-primary); background: rgba(255,255,255,.72); font-size: 21rpx; font-weight: 700; }
.score-card { position: relative; min-height: 258rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 38rpx; padding: 32rpx; overflow: hidden; border-radius: var(--radius-xl); color: #fff; background: linear-gradient(145deg, #244d40 0%, #16372e 100%); box-shadow: 0 18rpx 42rpx rgba(25,59,47,.2); }
.score-card::after { content: ''; position: absolute; right: -64rpx; bottom: -100rpx; width: 260rpx; height: 260rpx; border: 1rpx solid rgba(255,255,255,.11); border-radius: 50%; }
.score-card__copy, .score-card__visual { position: relative; z-index: 1; }
.score-card__label, .score-card__hint { display: block; }
.score-card__label { color: rgba(255,255,255,.7); font-size: var(--font-size-xs); }
.score-card__number { display: flex; align-items: baseline; margin-top: 10rpx; }
.score-card__number text:first-child { font-size: 72rpx; font-weight: 740; letter-spacing: -3rpx; line-height: 1; }
.score-card__number text:last-child { margin-left: 5rpx; color: rgba(255,255,255,.72); font-size: 27rpx; }
.score-card__hint { margin-top: 16rpx; color: rgba(255,255,255,.54); font-size: var(--font-size-2xs); }
.score-card__ring { width: 134rpx; height: 134rpx; display: flex; align-items: center; justify-content: center; border: 12rpx solid rgba(255,255,255,.14); border-top-color: #77bba4; border-right-color: #77bba4; border-radius: 50%; transform: rotate(18deg); }
.score-card__ring-inner { display: flex; flex-direction: column; align-items: center; transform: rotate(-18deg); }
.score-card__ring-inner text:first-child { font-size: 34rpx; font-weight: 700; }
.score-card__ring-inner text:last-child { margin-top: 3rpx; color: rgba(255,255,255,.66); font-size: 19rpx; }
.stats { display: flex; justify-content: space-between; margin-top: 18rpx; }
.stat-card { width: calc(33.333% - 9rpx); min-height: 138rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,254,250,.85); }
.stat-card__value, .stat-card__label { display: block; }
.stat-card__value { color: var(--color-ink); font-size: 39rpx; font-weight: 720; }
.stat-card__label { margin-top: 6rpx; color: var(--color-text-secondary); font-size: var(--font-size-2xs); }
.pattern-card { margin-top: 18rpx; padding: 30rpx; }
.pattern-card__head { display: flex; align-items: center; gap: 14rpx; }
.pattern-card__mark { display: flex; align-items: flex-end; gap: 4rpx; width: 30rpx; height: 28rpx; }
.pattern-card__mark view { width: 5rpx; border-radius: 3rpx; background: var(--color-primary-light); }
.pattern-card__mark view:nth-child(1) { height: 11rpx; }.pattern-card__mark view:nth-child(2) { height: 19rpx; }.pattern-card__mark view:nth-child(3) { height: 28rpx; }
.pattern-card__title { display: block; margin-top: 24rpx; color: var(--color-ink); font-size: 34rpx; font-weight: 660; line-height: 1.55; }
.pattern-card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx; margin-top: 25rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); color: var(--color-text-placeholder); font-size: var(--font-size-2xs); }
.focus-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 42rpx 3rpx 20rpx; }
.focus-title { display: block; margin-top: 8rpx; color: var(--color-ink); font-size: 32rpx; font-weight: 680; }
.focus-head__hint { color: var(--color-text-placeholder); font-size: var(--font-size-2xs); }
.focus-list { display: flex; flex-direction: column; gap: 13rpx; }
.focus-choice { min-height: 92rpx; display: flex; align-items: center; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,254,250,.88); transition: transform .16s ease; }
.focus-choice__radio { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; flex: none; margin-right: 18rpx; border: 2rpx solid var(--color-border-strong); border-radius: 50%; }
.focus-choice__radio view { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--color-primary); }
.focus-choice > text:nth-child(2) { flex: 1; font-weight: 560; }
.focus-choice__arrow { color: var(--color-text-placeholder); font-size: 39rpx; }
.focus-choice--selected { color: var(--color-primary-dark); border-color: rgba(31,104,85,.45); background: var(--color-primary-soft); }
.focus-choice--selected .focus-choice__radio { border-color: var(--color-primary); }
.state-card--period-empty { margin-top: 18rpx; }
