.ai-review {padding-top:26rpx;}
.ai-review::before {display:none;}
.ai-review .page-title {margin-top:0;font-size:calc(46rpx * var(--review-font-scale, 1));}
.ai-source {display:flex;align-items:center;gap:8rpx;min-height:88rpx;margin:8rpx 0 16rpx;color:var(--color-text-secondary);font-size:calc(24rpx * var(--review-font-scale, 1));}
.ai-arrow {padding-left:8rpx;color:var(--color-primary);}
.ai-paper {padding:0 36rpx;background:var(--color-paper);border:1rpx solid var(--color-border);border-radius:34rpx;}
.ai-finding {padding:36rpx 0 20rpx;}
.ai-finding + .ai-finding {border-top:1rpx solid var(--color-border);}
.ai-kind {display:block;margin-bottom:14rpx;color:var(--color-primary);font-size:calc(24rpx * var(--review-font-scale, 1));font-weight:500;line-height:1.6;letter-spacing:1rpx;}
.ai-kind--adjust {color:var(--color-warm-dark);}
.ai-title {display:block;margin-bottom:14rpx;color:var(--color-ink);font-size:calc(36rpx * var(--review-font-scale, 1));font-weight:650;line-height:1.55;overflow-wrap:anywhere;}
.ai-summary {display:block;color:var(--color-ink-soft);font-size:calc(27rpx * var(--review-font-scale, 1));line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;}
.ai-actions {display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:14rpx;}
.ai-evidence-link {display:flex;align-items:center;gap:12rpx;min-height:88rpx;color:var(--color-primary);font-size:calc(25rpx * var(--review-font-scale, 1));}
.ai-bookmark {display:flex;align-items:center;justify-content:center;min-height:80rpx;padding:12rpx 24rpx;border-radius:18rpx;background:var(--color-primary-soft);color:var(--color-primary);font-size:calc(24rpx * var(--review-font-scale, 1));line-height:1.6;flex:none;}
.ai-current {padding:34rpx 4rpx 30rpx;min-height:160rpx;}
.ai-current__head {display:flex;align-items:center;justify-content:space-between;gap:28rpx;min-height:48rpx;}
.ai-current__label {display:block;color:var(--color-text-secondary);font-size:calc(26rpx * var(--review-font-scale, 1));line-height:1.6;}
.ai-current__text {display:block;margin-top:8rpx;color:var(--color-ink);font-size:calc(34rpx * var(--review-font-scale, 1));font-weight:500;line-height:1.65;overflow-wrap:anywhere;}
.ai-current__action {color:var(--color-primary);font-size:calc(26rpx * var(--review-font-scale, 1));line-height:1.6;flex:none;}
.ai-secondary {display:flex;justify-content:space-between;gap:22rpx;border-top:1rpx solid var(--color-border);color:var(--color-text-secondary);font-size:calc(24rpx * var(--review-font-scale, 1));}
.ai-secondary > view {min-height:100rpx;display:flex;align-items:center;}
.ai-secondary > view:only-child {margin-left:auto;}
.ai-state {margin:20rpx 0;padding:26rpx 8rpx;}
.ai-inline {display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:76rpx;margin-bottom:16rpx;color:var(--color-primary);font-size:calc(25rpx * var(--review-font-scale, 1));line-height:1.7;}
.ai-inline--error {align-items:flex-start;color:var(--color-text-secondary);}
.ai-breath {flex:none;width:12rpx;height:12rpx;border-radius:50%;background:var(--color-primary-light);}
.ai-inline .ai-breath + text {flex:1;}
.ai-touch {display:flex;align-items:center;justify-content:center;min-height:88rpx;flex:none;color:var(--color-primary);font-size:calc(24rpx * var(--review-font-scale, 1));}
.ai-notice {display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:24rpx 0 0;padding:6rpx 22rpx;border-radius:16rpx;background:var(--color-primary-soft);color:var(--color-primary);font-size:calc(24rpx * var(--review-font-scale, 1));line-height:1.6;}
.ai-notice > text {flex:1;min-width:0;}
.ai-notice > view {min-height:76rpx;display:flex;align-items:center;flex:none;}
.ai-overlay {position:fixed;inset:0;z-index:950;display:flex;align-items:flex-end;background:rgba(23,38,33,.3);}
.ai-sheet {width:100%;max-height:88vh;padding:0 34rpx calc(env(safe-area-inset-bottom) + 12rpx);background:var(--color-paper);border-radius:32rpx 32rpx 0 0;}
.ai-sheet__handle {width:54rpx;height:6rpx;margin:16rpx auto 8rpx;border-radius:6rpx;background:var(--color-border-strong);}
.ai-sheet__head {display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:92rpx;font-size:calc(29rpx * var(--review-font-scale, 1));color:var(--color-ink);}
.ai-close {width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;margin-right:-14rpx;flex:none;}
.ai-close > text {width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--color-border);border-radius:50%;color:var(--color-text-secondary);background:var(--color-bg-page);font-size:calc(35rpx * var(--review-font-scale, 1));}
.ai-sheet__scroll {height:64vh;}
.ai-sheet__scroll .ai-title {font-size:calc(34rpx * var(--review-font-scale, 1));}
.ai-limit {display:block;margin:18rpx 0;color:var(--color-text-secondary);font-size:calc(24rpx * var(--review-font-scale, 1));line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;}
.ai-record {border-top:1rpx solid var(--color-border);padding:28rpx 0 12rpx;}
.ai-record__head {display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;}
.ai-record__head > view {display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;flex:1;min-width:0;}
.ai-record__symbol {font-size:calc(29rpx * var(--review-font-scale, 1));font-weight:600;line-height:1.6;overflow-wrap:anywhere;}
.ai-record__action {color:var(--color-text-secondary);font-size:calc(23rpx * var(--review-font-scale, 1));}
.ai-record__date {color:var(--color-text-secondary);font-size:calc(22rpx * var(--review-font-scale, 1));line-height:1.8;text-align:right;flex:none;max-width:45%;}
.ai-unexecuted {color:var(--color-warm-dark);background:var(--color-warm-soft);border-radius:8rpx;padding:2rpx 9rpx;font-size:calc(22rpx * var(--review-font-scale, 1));}
.ai-story {display:flex;align-items:flex-start;gap:18rpx;margin-top:18rpx;}
.ai-story__label {flex:none;width:calc(48rpx * var(--review-font-scale, 1));color:var(--color-text-secondary);font-size:calc(23rpx * var(--review-font-scale, 1));line-height:1.8;}
.ai-story__body {flex:1;min-width:0;}
.ai-story__copy {display:block;flex:1;min-width:0;font-size:calc(26rpx * var(--review-font-scale, 1));line-height:1.8;color:var(--color-ink-soft);white-space:pre-wrap;overflow-wrap:anywhere;}
.ai-story__meta {display:block;margin-top:6rpx;color:var(--color-text-secondary);font-size:calc(22rpx * var(--review-font-scale, 1));line-height:1.6;}
.ai-story__reason {display:block;margin-top:6rpx;color:var(--color-ink-soft);font-size:calc(24rpx * var(--review-font-scale, 1));line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;}
.ai-record__footer {display:flex;align-items:center;justify-content:flex-end;min-height:80rpx;color:var(--color-primary);font-size:calc(24rpx * var(--review-font-scale, 1));margin-top:6rpx;}
.ai-list-state {display:flex;align-items:center;justify-content:center;min-height:140rpx;color:var(--color-text-secondary);font-size:calc(25rpx * var(--review-font-scale, 1));line-height:1.75;padding:20rpx 0;}
.ai-detail-actions {display:flex;align-items:center;justify-content:space-between;gap:22rpx;min-height:120rpx;border-top:1rpx solid var(--color-border);}
.ai-other {display:flex;align-items:center;justify-content:space-between;gap:22rpx;padding:24rpx 0;min-height:130rpx;border-top:1rpx solid var(--color-border);}
.ai-other > view:first-child {flex:1;min-width:0;}
.ai-other .ai-kind {margin-bottom:8rpx;font-size:calc(23rpx * var(--review-font-scale, 1));}
.ai-other__title {display:block;color:var(--color-ink);font-size:calc(29rpx * var(--review-font-scale, 1));line-height:1.65;overflow-wrap:anywhere;}
.ai-other > text:last-child {color:var(--color-primary);}
.ai-reminder-editor {padding:12rpx 0 0;height:calc(650rpx * var(--review-font-scale, 1));max-height:calc(88vh - var(--review-keyboard-height, 0px) - 140rpx - env(safe-area-inset-bottom));}
.ai-reminder-input {width:100%;height:180rpx;max-height:22vh;margin-top:24rpx;padding:24rpx;border:1rpx solid var(--color-border);border-radius:20rpx;background:var(--color-bg-page);color:var(--color-ink);font-size:calc(30rpx * var(--review-font-scale, 1));line-height:1.8;box-sizing:border-box;}
.ai-reminder-error {display:block;color:var(--color-danger);font-size:calc(24rpx * var(--review-font-scale, 1));line-height:1.6;margin:12rpx 0;}
.ai-save {width:100%;margin-top:24rpx;font-size:calc(28rpx * var(--review-font-scale, 1));}
.ai-cancel {display:flex;align-items:center;justify-content:center;min-height:88rpx;color:var(--color-text-secondary);font-size:calc(25rpx * var(--review-font-scale, 1));}
.ai-sources {padding:14rpx 0 30rpx;}
.ai-sources-scroll {max-height:64vh;}
